# Copy to .env. Never commit credentials or collected user data.
APP_ENV=development
WEB_PORT=8080

# Storage is configured separately; set these locally before running PostgreSQL.
# POSTGRES_PASSWORD=<generate-a-local-password>
# POSTGRES_PORT=5433
# TEST_POSTGRES_PORT=55433
# DATABASE_URL=postgresql+psycopg://bilibili:<password>@127.0.0.1:5433/bilibili_talks
# TEST_DATABASE_URL=postgresql+psycopg://bilibili:<password>@127.0.0.1:55433/bilibili_talks_test

# Shared and persistent for every collector CLI in this deployment.
# BILIBILI_CONTROL_DIR=data/collection-control

# Persistent scheduler workspace; use the same root when restarting the worker.
# JOB_DATA_ROOT=data/jobs
# BILIBILI_COOKIE_FILE=data/credentials/bilibili-cookie.txt

# HTTP API configuration. Keep these backend-only; never use VITE_ prefixes.
# ADMIN_TOKEN=<long-random-operator-token>
# RATE_LIMIT_SECRET=<different-stable-random-hmac-key>
# TRUSTED_PROXIES=127.0.0.1/32
