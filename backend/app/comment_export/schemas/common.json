{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bilibili-talks-view:common:1",
  "$defs": {
    "author": {
      "type": "object",
      "properties": {
        "uid": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "nickname": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "uid",
        "nickname"
      ]
    },
    "content": {
      "type": "object",
      "properties": {
        "text": {
          "type": [
            "string",
            "null"
          ]
        },
        "images": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "url": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "width": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "height": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "url",
              "width",
              "height"
            ]
          }
        },
        "emotes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "token": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "url": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "token",
              "url"
            ]
          }
        }
      },
      "required": [
        "text",
        "images",
        "emotes"
      ]
    }
  }
}
